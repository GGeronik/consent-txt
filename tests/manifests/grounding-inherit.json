{
  "version": "0.1",
  "publisher": {
    "name": "Test Site",
    "url": "https://test.example",
    "contact": "mailto:ai@test.example"
  },
  "defaults": {
    "fallbacks": {
      "unexpressible_state": "unknown"
    },
    "standard": {
      "train-ai": {
        "state": "deny"
      },
      "search": {
        "state": "allow"
      }
    },
    "experimental": {
      "ai-input": {
        "state": "allow"
      }
    }
  },
  "rules": [
    {
      "match": {
        "path": "/blog/*"
      },
      "standard": {
        "train-ai": {
          "state": "allow"
        }
      }
    },
    {
      "match": {
        "path": "/blog/premium/*"
      },
      "standard": {
        "train-ai": {
          "state": "charge",
          "conditions": {
            "payment_plan": "p"
          }
        }
      },
      "experimental": {
        "ai-input": {
          "state": "deny"
        }
      }
    },
    {
      "match": {
        "path": "/p/*"
      },
      "experimental": {
        "ai-input": {
          "state": "deny"
        }
      }
    },
    {
      "match": {
        "path": "/p/q/*"
      },
      "standard": {
        "train-ai": {
          "state": "unknown"
        }
      }
    }
  ],
  "endpoints": {
    "payment": "https://test.example/pay"
  }
}
