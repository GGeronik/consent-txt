{
  "version": "0.1",
  "publisher": {
    "name": "Test Site",
    "url": "https://test.example",
    "contact": "mailto:ai@test.example"
  },
  "defaults": {
    "standard": {
      "train-ai": {
        "state": "allow"
      },
      "search": {
        "state": "allow"
      }
    }
  },
  "rules": [
    {
      "match": {
        "path": "/members/*"
      },
      "standard": {
        "train-ai": {
          "state": "deny"
        }
      }
    },
    {
      "match": {
        "path": "/members/*",
        "hostname": "open.test.example"
      },
      "standard": {
        "train-ai": {
          "state": "allow"
        }
      }
    },
    {
      "match": {
        "path": "/members/public/*",
        "hostname": "open.test.example"
      },
      "standard": {
        "train-ai": {
          "state": "allow"
        }
      }
    },
    {
      "match": {
        "path": "/paid/*",
        "content_types": [
          "text/html"
        ]
      },
      "experimental": {
        "ai-input": {
          "state": "deny"
        }
      }
    }
  ]
}
